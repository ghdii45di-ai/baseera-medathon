# Example only. No secrets are required for the public simulation.
VITE_BASEERA_MODE=simulation
VITE_API_BASE=/api
# Backend reads process environment, not this Vite file.
BASEERA_MODE=simulation
BASEERA_MODEL_PROVIDER=unavailable
BASEERA_DOWNLOAD_MODEL=false
BASEERA_MODEL_PATH=weights/aldahmashi/final_model.keras
BASEERA_CPU_THREADS=2
BASEERA_INFERENCE_PER_MINUTE=10
BASEERA_SERVE_FRONTEND=false
BASEERA_FRONTEND_DIR=dist
PORT=7860
BASEERA_CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
# Local research requires explicit frontend AND backend opt-in; see README.
# VITE_BASEERA_MODE=research must be used only with --mode research locally.
# BASEERA_MODE=research must never be enabled on the public host.
